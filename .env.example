# ==================== Twilio ==============================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ==================== OpenAI ==============================================
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === PostgreSQL superuser (used by the postgres container to bootstrap) ====
POSTGRES_DB=whatsapp_bot_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<generate with: openssl rand -base64 16>

# ================= Application database user (used by Flask) ===============
DB_HOST=db
DB_PORT=5432
DB_NAME=whatsapp_bot_db
DB_USER=whatsapp_bot_user
DB_PASSWORD=<generate with: openssl rand -base64 16>

# ===================== Airflow database user ==============================
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=<generate with: openssl rand -base64 16>
AIRFLOW_DB_NAME=airflow_db
